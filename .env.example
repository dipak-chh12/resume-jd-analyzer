# Groq API Configuration
GROQ_API_KEY= ""
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Database Configuration (Falls back to SQLite sqlite:///./resume_matcher.db if PostgreSQL is unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_matcher

# Vector Store Configuration (Falls back to memory/local storage if Qdrant is unreachable)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Mock AI Mode (Set to true to run offline without Groq or SentenceTransformers)
MOCK_AI=false
